{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [":preserveSemverRanges", "config:best-practices", "replacements:all"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub Actions versions used by create-typescript-monorepo-bingo",
      "managerFilePatterns": [
        "/packages/create-typescript-monorepo-bingo/src/utils/actions\\.ts$/"
      ],
      "matchStrings": [
        "'[^']+': \\['(?<currentValue>[^']+)', '(?<currentDigest>[0-9a-f]{40})'\\], // renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    }
  ]
}
